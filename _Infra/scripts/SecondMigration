-- 1. Удаление старой структуры параметров -- DDL

DROP TABLE parametry;
DROP TABLE bazovye_edinicy_izmereniya;	--|
DROP TABLE edinicy_izmereniya;			--| Для рестарта текущего кода
DROP TABLE tipy_parametrov;				--|

-- 2. Справочники -- DDL

 
-- 2.1 Базовые единицы измерения (физическая величина: длина, температура и т.д.)

CREATE TABLE bazovye_edinicy_izmereniya (
    id INTEGER NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_bazovye_edinicy_izmereniya PRIMARY KEY (id)
);
 
-- 2.2 Единицы измерения (метр, градус Цельсия, мм рт.ст. и т.д.) 

CREATE TABLE edinicy_izmereniya (
    id INTEGER NOT NULL,
    bazovaya_edinica_id INTEGER NOT NULL,
    short_name VARCHAR(20) NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_edinicy_izmereniya PRIMARY KEY (id),
    CONSTRAINT fk_edinicy_izmereniya_bazovaya FOREIGN KEY (bazovaya_edinica_id)
        REFERENCES bazovye_edinicy_izmereniya (id)
);
 
-- 2.3 Типы параметров (высота, температура, давление, направление и
--     скорость ветра, дальность сноса пуль)

CREATE TABLE tipy_parametrov (
    id INTEGER NOT NULL,
    edinica_izmereniya_id INTEGER NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_tipy_parametrov PRIMARY KEY (id),
    CONSTRAINT fk_tipy_parametrov_edinica FOREIGN KEY (edinica_izmereniya_id)
        REFERENCES edinicy_izmereniya (id)
);

 
-- 3. Новая таблица параметров -- DDL
--    Связка: пачка (parametry.pachka_id) <-> тип параметра <-> значение

CREATE TABLE parametry (
    id INTEGER NOT NULL,
    pachka_id INTEGER NOT NULL,
    tip_parametra_id INTEGER NOT NULL,
    value DECIMAL(8,2) NOT NULL,
    CONSTRAINT pk_parametry PRIMARY KEY (id),
    CONSTRAINT uq_parametry_pachka_tip UNIQUE (pachka_id, tip_parametra_id),
    CONSTRAINT fk_parametry_pachka FOREIGN KEY (pachka_id)
        REFERENCES pachki (id),
    CONSTRAINT fk_parametry_tip_parametra FOREIGN KEY (tip_parametra_id)
        REFERENCES tipy_parametrov (id)
);
 

