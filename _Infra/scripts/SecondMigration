-- 1. Справочники -- DDL

 
-- 1.1 Базовые единицы измерения (физическая величина: длина, температура и т.д.)
CREATE TABLE bazovye_edinicy_izmereniya (
    id INTEGER NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_bazovye_edinicy_izmereniya PRIMARY KEY (id)
);
 
-- 1.2 Единицы измерения (метр, градус Цельсия, мм рт.ст. и т.д.)
CREATE TABLE edinicy_izmereniya (
    id INTEGER NOT NULL,
    bazovaya_edinica_id INTEGER NOT NULL,
    short_name VARCHAR(20) NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_edinicy_izmereniya PRIMARY KEY (id),
    CONSTRAINT fk_edinicy_izmereniya_bazovaya FOREIGN KEY (bazovaya_edinica_id)
        REFERENCES bazovye_edinicy_izmereniya (id)
);
 
-- 1.3 Типы параметров (высота, температура, давление, направление и
--     скорость ветра, дальность сноса пуль) - из ТЗ
CREATE TABLE tipy_parametrov (
    id INTEGER NOT NULL,
    edinica_izmereniya_id INTEGER NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_tipy_parametrov PRIMARY KEY (id),
    CONSTRAINT fk_tipy_parametrov_edinica FOREIGN KEY (edinica_izmereniya_id)
        REFERENCES edinicy_izmereniya (id)
);
 

