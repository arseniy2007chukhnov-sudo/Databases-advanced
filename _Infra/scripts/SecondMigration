-- 7. Основной запрос
--    Дата измерения | Номер пачки | ФИО сотрудника |
--    Наименование параметра и ед. измерения | Значение

SELECT
    p.created_date                          AS "Дата измерения",
    p.id                                     AS "Номер пачки",
    u.full_name                             AS "ФИО сотрудника",
    tp.name || ' (' || ei.short_name || ')' AS "Параметр и ед. измерения",
    par.value                               AS "Значение"
FROM pachki p
    INNER JOIN polzovateli u
        ON u.id = p.polzovatel_id
    INNER JOIN parametry par
        ON par.pachka_id = p.id
    INNER JOIN tipy_parametrov tp
        ON tp.id = par.tip_parametra_id
    INNER JOIN edinicy_izmereniya ei
        ON ei.id = tp.edinica_izmereniya_id
ORDER BY
    p.created_date, p.id, tp.id;
 