-- 3. Приведение dolzhnosti / tipy_oborudovaniya к ТЗ -- DML

 
UPDATE dolzhnosti SET name = 'Рядовой'   WHERE id = 1;
UPDATE dolzhnosti SET name = 'Лейтенант' WHERE id = 2;
 
UPDATE tipy_oborudovaniya SET name = 'ДМК (Десантный метео комплекс)' WHERE id = 1;
UPDATE tipy_oborudovaniya SET name = 'ВР (Ветровое ружье)'           WHERE id = 2;
 

-- 4. Исправление структуры parametry -- DDL

 
ALTER TABLE parametry
    ADD COLUMN tip_parametra_id INTEGER;
 

-- 5. Существующие 4 строки parametry переиспользованы под параметры из ТЗ
--    -- DML (id и uniq_code не меняются, меняется, что они означают).

 
UPDATE parametry
   SET tip_oborudovaniya_id = 1, tip_parametra_id = 1, value = '100'
 WHERE id = 1;  -- Высота (ДМК)
 
UPDATE parametry
   SET tip_oborudovaniya_id = 1, tip_parametra_id = 2, value = '12'
 WHERE id = 2;  -- Температура (ДМК)
 
UPDATE parametry
   SET tip_oborudovaniya_id = 2, tip_parametra_id = 1, value = '80'
 WHERE id = 3;  -- Высота (ВР)
 
UPDATE parametry
   SET tip_oborudovaniya_id = 2, tip_parametra_id = 2, value = '10'
 WHERE id = 4;  -- Температура (ВР)
 

-- 6. Ограничение целостности на новую колонку -- DD

 
ALTER TABLE parametry
    ADD CONSTRAINT fk_parametry_tip_parametra FOREIGN KEY (tip_parametra_id)
        REFERENCES tipy_parametrov (id);
 

-- 7. Старая свободнотекстовая колонка (NOT NULL) больше не нужна -- DDL


 
ALTER TABLE parametry
    DROP COLUMN name;
 

-- 8. Переназначение остальных зависимых записей -- DML

 
UPDATE polzovateli
   SET dolzhnost_id = 1                 -- Сидорова -> Рядовой
 WHERE id = 3;
 
UPDATE pachki
   SET tip_oborudovaniya_id = 1         -- PCH-003 -> ДМК
 WHERE id = 3;
 

-- 9. Удаление справочных строк, на которые теперь никто не ссылается -- DML

 
DELETE FROM dolzhnosti        WHERE id = 3;  -- 'Начальник склада'
DELETE FROM tipy_oborudovaniya WHERE id = 3;  -- 'Принтер'
 

