SELECT
    p.uniq_code AS pachka_code,
    t.uniq_code AS tip_code,
    t.name AS tip_oborudovaniya,
    par.uniq_code AS param_code,
    par.name AS parametr,
    par.value AS znachenie,
    u.uniq_code AS user_code,
    u.full_name AS polzovatel,
    d.uniq_code AS dolzhnost_code,
    d.name AS dolzhnost,
    p.quantity AS kolichestvo,
    p.created_date AS data_partii
FROM pachki AS p
JOIN tipy_oborudovaniya AS t ON p.tip_oborudovaniya_id = t.id
JOIN polzovateli AS u ON p.polzovatel_id = u.id
JOIN dolzhnosti AS d ON u.dolzhnost_id = d.id
JOIN parametry AS par ON par.tip_oborudovaniya_id = t.id
ORDER BY p.uniq_code, par.uniq_code;