DROP TABLE IF EXISTS pachki;
DROP TABLE IF EXISTS parametry;
DROP TABLE IF EXISTS polzovateli;
DROP TABLE IF EXISTS tipy_oborudovaniya;
DROP TABLE IF EXISTS dolzhnosti;

-- Должности
CREATE TABLE dolzhnosti (
    id INTEGER NOT NULL,
    uniq_code VARCHAR(20) NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_dolzhnosti PRIMARY KEY (id),
    CONSTRAINT uq_dolzhnosti_code UNIQUE (uniq_code)
);
 
-- Типы оборудования
CREATE TABLE tipy_oborudovaniya (
    id INTEGER NOT NULL,
    uniq_code VARCHAR(20) NOT NULL,
    name VARCHAR(100) NOT NULL,
    CONSTRAINT pk_tipy_oborudovaniya PRIMARY KEY (id),
    CONSTRAINT uq_tipy_oborudovaniya_code UNIQUE (uniq_code)
);
 
-- Пользователи (ссылаются на должность)
CREATE TABLE polzovateli (
    id INTEGER NOT NULL,
    uniq_code VARCHAR(20) NOT NULL,
    full_name VARCHAR(150) NOT NULL,
    dolzhnost_id INTEGER NOT NULL,
    CONSTRAINT pk_polzovateli PRIMARY KEY (id),
    CONSTRAINT uq_polzovateli_code UNIQUE (uniq_code),
    CONSTRAINT fk_polzovateli_dolzhnost FOREIGN KEY (dolzhnost_id)
        REFERENCES dolzhnosti (id)
);
 
-- Параметры (характеристики конкретного типа оборудования)
CREATE TABLE parametry (
    id INTEGER NOT NULL,
    uniq_code VARCHAR(20) NOT NULL,
    tip_oborudovaniya_id INTEGER NOT NULL,
    name VARCHAR(100) NOT NULL,
    value VARCHAR(100) NOT NULL,
    CONSTRAINT pk_parametry PRIMARY KEY (id),
    CONSTRAINT uq_parametry_code UNIQUE (uniq_code),
    CONSTRAINT fk_parametry_tip FOREIGN KEY (tip_oborudovaniya_id)
        REFERENCES tipy_oborudovaniya (id)
);
 
-- Пачки (партии оборудования, принятые/выданные пользователем)
CREATE TABLE pachki (
    id INTEGER NOT NULL,
    uniq_code VARCHAR(20) NOT NULL,
    tip_oborudovaniya_id INTEGER NOT NULL,
    polzovatel_id INTEGER NOT NULL,
    quantity INTEGER NOT NULL,
    created_date DATE NOT NULL,
    CONSTRAINT pk_pachki PRIMARY KEY (id),
    CONSTRAINT uq_pachki_code UNIQUE (uniq_code),
    CONSTRAINT ck_pachki_quantity CHECK (quantity > 0),
    CONSTRAINT fk_pachki_tip FOREIGN KEY (tip_oborudovaniya_id)
        REFERENCES tipy_oborudovaniya (id),
    CONSTRAINT fk_pachki_polzovatel FOREIGN KEY (polzovatel_id)
        REFERENCES polzovateli (id)
);

